import express from 'express';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = 3000;

app.use(express.json({ limit: '10mb' }));
app.use(express.static(path.join(__dirname, 'public')));

// Mocked SQLite for AI Studio environment
const _data = { camps: [], settings: [] };
const db = { 
    pragma: () => {}, 
    exec: () => {}, 
    prepare: (query) => ({ 
        get: (...args) => {
            if (query.includes('table_info(camps)')) return null;
            if (query.includes('SELECT * FROM camps WHERE id = ?')) return _data.camps.find(c => c.id === args[0]);
            return null;
        }, 
        all: (...args) => {
            if (query.includes('table_info(camps)')) {
                return [{ name: 'title' }, { name: 'logo' }, { name: 'locked' }, { name: 'numLang' }, { name: 'dir' }, { name: 'users' }];
            }
            if (query.includes('SELECT key, value FROM settings')) return _data.settings;
            if (query.includes('SELECT id, orgName, title, locked FROM camps')) return _data.camps;
            return [];
        }, 
        run: (...args) => {
            if (query.includes('INSERT INTO settings')) {
                const idx = _data.settings.findIndex(s => s.key === args[0]);
                if (idx >= 0) _data.settings[idx].value = args[1];
                else _data.settings.push({ key: args[0], value: args[1] });
            }
            if (query.includes('INSERT INTO camps')) {
                _data.camps.push({
                    id: args[0], orgName: args[1], title: args[2], logo: args[3], password: args[4],
                    teams: args[5], stages: args[6], locked: 0, numLang: args[7], dir: args[8], users: args[9], campType: args[10] || 'simple'
                });
            }
            if (query.includes('UPDATE camps SET orgName = ?')) {
                const c = _data.camps.find(c => c.id === args[10]);
                if (c) {
                    c.orgName = args[0]; c.title = args[1]; c.logo = args[2]; c.password = args[3];
                    c.teams = args[4]; c.stages = args[5]; c.numLang = args[6]; c.dir = args[7]; c.users = args[8]; c.campType = args[9] || 'simple';
                }
            }
            if (query.includes('UPDATE camps SET locked = ?')) {
                const c = _data.camps.find(c => c.id === args[1]);
                if (c) c.locked = args[0];
            }
            if (query.includes('UPDATE camps SET teams = ?, stages = ?, orgName')) {
                const c = _data.camps.find(c => c.id === args[7]);
                if (c) { c.teams = args[0]; c.stages = args[1]; c.orgName = args[2]; c.title = args[3]; c.logo = args[4]; c.numLang = args[5]; c.dir = args[6]; }
            }
            else if (query.includes('UPDATE camps SET teams = ?, stages = ?')) {
                const c = _data.camps.find(c => c.id === args[2]);
                if (c) { c.teams = args[0]; c.stages = args[1]; }
            }
            else if (query.includes('UPDATE camps SET teams = ?')) {
                const c = _data.camps.find(c => c.id === args[1]);
                if (c) { c.teams = args[0]; }
            }
            if (query.includes('DELETE FROM camps')) {
                _data.camps = _data.camps.filter(c => c.id !== args[0]);
            }
            return { changes: 1 };
        } 
    }) 
};

// Ensure the table is created
db.exec(`
    CREATE TABLE IF NOT EXISTS camps (
        id TEXT PRIMARY KEY,
        orgName TEXT,
        password TEXT,
        teams TEXT,
        stages TEXT,
        title TEXT,
        logo TEXT,
        locked INTEGER DEFAULT 0
    )
`);


db.exec(`
    CREATE TABLE IF NOT EXISTS settings (
        key TEXT PRIMARY KEY,
        value TEXT
    )
`);

// Global Settings Endpoints
app.get('/api/settings', async (req, res) => {
    try {
        const stmt = db.prepare('SELECT key, value FROM settings');
        const rows = stmt.all();
        const settings = {};
        rows.forEach(r => { settings[r.key] = r.value; });
        res.json(settings);
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

app.post('/api/settings', async (req, res) => {
    const { key, value } = req.body;
    try {
        const stmt = db.prepare('INSERT INTO settings (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value');
        stmt.run(key, value);
        res.json({ success: true });
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// Add new columns if they don't exist

const cols = [
    { name: 'title', type: 'TEXT' },
    { name: 'logo', type: 'TEXT' },
    { name: 'locked', type: 'INTEGER DEFAULT 0' },
    { name: 'numLang', type: 'TEXT DEFAULT "fa"' },
    { name: 'dir', type: 'TEXT DEFAULT "rtl"' },
    { name: 'campType', type: 'TEXT DEFAULT "simple"' },
    { name: 'users', type: 'TEXT DEFAULT "[]"' }
];
const tableInfo = db.prepare("PRAGMA table_info(camps)").all();
cols.forEach(col => {
    const hasCol = tableInfo.some(c => c.name === col.name);
    if (!hasCol) {
        db.prepare(`ALTER TABLE camps ADD COLUMN ${col.name} ${col.type}`).run();
    }
});

const SUPERADMIN_PASS = process.env.SUPERADMIN_PASS || 'admin123';
const sseClients = new Map(); // Map<campId, Set<Response>>

app.get('/', (req, res) => res.redirect('/superadmin.html'));

app.post('/superadmin/login', async (req, res) => {
    if (req.body.password === SUPERADMIN_PASS) res.json({ success: true });
    else res.json({ success: false, message: "رمز عبور سوپرادمین اشتباه است!" });
});

app.get('/superadmin/camps', async (req, res) => {
    const campsSnap = await db.collection('camps').get(); const camps = campsSnap.docs.map(d => { const data = d.data(); return { id: d.id, orgName: data.orgName, title: data.title, locked: data.locked, campType: data.campType }; });
    res.json({ success: true, camps });
});

app.get('/superadmin/camps/:id', (req, res) => {
    const camp = db.prepare('SELECT * FROM camps WHERE id = ?').get(req.params.id);
    if (camp) {
        res.json({ 
            success: true, 
            camp: { ...camp, teams: JSON.parse(camp.teams || '[]'), stages: JSON.parse(camp.stages || '[]'), users: JSON.parse(camp.users || '[]'), locked: camp.locked === 1 }
        });
    } else {
        res.json({ success: false, message: "یافت نشد" });
    }
});

app.post('/superadmin/camps/:id/lock', async (req, res) => {
    const isLocked = req.body.locked ? 1 : 0;
    db.prepare('UPDATE camps SET locked = ? WHERE id = ?').run(isLocked, req.params.id);
    broadcastState(req.params.id);
    res.json({ success: true });
});

app.post('/setup', async (req, res) => {
    const { campId, orgName, title, logo, password, teams, stages, numLang, dir, users, campType } = req.body;
    if (campId) {
        await updateCamp(campId, { orgName, title, logo, password, teams, stages, numLang: numLang || 'fa', dir: dir || 'rtl', users: users || [], campType: campType || 'simple' });
        await broadcastState(campId);
        res.json({ success: true, campId });
    } else {
        const newCampId = 'camp_' + Math.random().toString(36).substr(2, 9);
        await updateCamp(newCampId, { id: newCampId, orgName, title, logo, password, teams, stages, locked: 0, numLang: numLang || 'fa', dir: dir || 'rtl', users: users || [], campType: campType || 'simple' });
        res.json({ success: true, campId: newCampId });
    }
});

app.post('/login', async (req, res) => {
    const { id, password, username } = req.body;
    
    if (!username) {
        return res.json({ success: false, message: "نام کاربری الزامی است!" });
    }
    
    const camp = await getCamp(id);
    if (camp) {
        let loggedUser = null;
        const users = camp.users ? JSON.parse(camp.users) : [];
        loggedUser = users.find(u => u.username === username && u.password === password);
        
        // Fallback for default operator (if not explicitly in the users list)
        if (!loggedUser && username === 'admin' && camp.password === password) {
            loggedUser = { role: 'operator', firstName: 'اپراتور', lastName: 'اصلی', username: 'admin' };
        }
        
        if (loggedUser) {
            return res.json({ 
                success: true, teams: JSON.parse(camp.teams), stages: camp.stages ? JSON.parse(camp.stages) : [],
                orgName: camp.orgName, title: camp.title, logo: camp.logo, locked: camp.locked === 1, numLang: camp.numLang || 'fa', dir: camp.dir || 'rtl',
                user: loggedUser
            });
        }
    }
    res.json({ success: false, message: "نام کاربری یا رمز عبور اشتباه است یا مسابقه یافت نشد!" });
});


setInterval(() => {
    for (const [id, clients] of sseClients.entries()) {
        for (const client of clients) {
            try { client.write(':\n\n'); } catch (e) { clients.delete(client); }
        }
    }
}, 15000);

async function broadcastState(id) {
    const clients = sseClients.get(id);
    if (clients && clients.size > 0) {
        const camp = await getCamp(id);
        if (camp) {
            const dataStr = `data: ${JSON.stringify({ 
                orgName: camp.orgName, title: camp.title, logo: camp.logo, locked: camp.locked === 1, numLang: camp.numLang || 'fa', dir: camp.dir || 'rtl',
                teams: JSON.parse(camp.teams), stages: camp.stages ? JSON.parse(camp.stages) : []
            })}\n\n`;
            for (const client of clients) { try { client.write(dataStr); } catch(e) { clients.delete(client); } }
        }
    }
}

app.get('/api', async (req, res) => {
    const { id, action } = req.query;
    if (action === 'info') {
        if (!id) return res.json({success: false});
        const camp = await getCamp(id);
        if (camp) return res.json({success: true, ...camp});
        return res.json({success: false});
        } else if (action === 'poll') {
        const camp = await getCamp(id);
        if (camp) {
            res.json({ 
                orgName: camp.orgName, title: camp.title, logo: camp.logo, locked: camp.locked === 1, numLang: camp.numLang || 'fa', dir: camp.dir || 'rtl',
                teams: JSON.parse(camp.teams), stages: camp.stages ? JSON.parse(camp.stages) : []
            });
        } else {
            res.status(404).json({error: 'not found'});
        }
    } else if (action === 'stream') {
        if (!id) return res.status(400).send("شناسه مسابقه وارد نشده است.");
        res.setHeader('Content-Type', 'text/event-stream');
        res.setHeader('Cache-Control', 'no-cache, no-transform');
        res.setHeader('X-Accel-Buffering', 'no');
        res.setHeader('Connection', 'keep-alive');
        
        res.flushHeaders();
        if (!sseClients.has(id)) sseClients.set(id, new Set());
        const clients = sseClients.get(id);
        clients.add(res);
        
        const camp = await getCamp(id);
        if (camp) {
            res.write(`data: ${JSON.stringify({ 
                orgName: camp.orgName, title: camp.title, logo: camp.logo, locked: camp.locked === 1, numLang: camp.numLang || 'fa', dir: camp.dir || 'rtl',
                teams: JSON.parse(camp.teams), stages: camp.stages ? JSON.parse(camp.stages) : []
            })}\n\n`);
        }
        req.on('close', () => clients.delete(res));
    } else res.status(400).send("Invalid action");
});

app.post('/api', async (req, res) => {
    const { id } = req.query;
    const { teams, stages, orgName, title, logo, numLang, dir } = req.body;
    if (!id) return res.status(400).send("شناسه مسابقه وارد نشده است.");
    
    const camp = await getCamp(id);
    if (camp) {
        if (camp.locked === 1) return res.status(403).json({ status: "error", message: "این مسابقه قفل شده است." });
        
        await updateCamp(id, { teams: teams || JSON.parse(camp.teams), stages: stages || (camp.stages ? JSON.parse(camp.stages) : []), orgName: orgName || camp.orgName, title: title !== undefined ? title : camp.title, logo: logo !== undefined ? logo : camp.logo, numLang: numLang || camp.numLang || 'fa', dir: dir || camp.dir || 'rtl' });
        await broadcastState(id);
    }
    res.json({ status: "success" });
});

app.post('/api/instant', async (req, res) => {
    const { id } = req.query;
    const { teamId, delta, teamName, user } = req.body;
    const camp = await getCamp(id);
    if (camp && camp.locked !== 1) {
        let teams = JSON.parse(camp.teams);
        let targetTeam = teams.find(t => t.id === teamId);
        if (targetTeam) {
            if (!targetTeam.scoreLogs) targetTeam.scoreLogs = [];
            targetTeam.scoreLogs.push({
                id: 'log_' + Math.random().toString(36).substr(2, 9),
                type: 'instant',
                value: delta,
                timestamp: Date.now(),
                user: user
            });
            
            let stageSum = 0;
            if (targetTeam.stageScores) {
                for (let s in targetTeam.stageScores) stageSum += (parseInt(targetTeam.stageScores[s]) || 0);
            }
            let logsSum = targetTeam.scoreLogs.reduce((sum, l) => sum + (parseInt(l.value)||0), 0);
            targetTeam.score = stageSum + logsSum;
            
            await updateCamp(id, { teams });
            
            // Broadcast Splash Event
            const clients = sseClients.get(id);
            if (clients) {
                const splashPayload = `event: splash\ndata: ${JSON.stringify({teamId, delta, teamName, score: targetTeam.score, user})}\n\n`;
                for (const client of clients) { try { client.write(splashPayload); } catch(e) { clients.delete(client); } }
            }
            await broadcastState(id);
        }
    }
    res.json({ success: true });
});


app.post('/api/undo_instant', async (req, res) => {
    const { id } = req.query;
    const { logId } = req.body;
    const camp = await getCamp(id);
    if (camp && camp.locked !== 1) {
        let teams = JSON.parse(camp.teams);
        let found = false;
        
        teams.forEach(t => {
            if (t.scoreLogs) {
                t.scoreLogs.forEach(l => {
                    if (l.id === logId && l.type === 'instant') {
                        l.type = 'cancelled';
                        l.timestamp = Date.now();
                        found = true;
                    }
                });
            }
            if (found) {
                let stageSum = 0;
                if (t.stageScores) {
                    for (let s in t.stageScores) stageSum += (parseInt(t.stageScores[s]) || 0);
                }
                let logsSum = t.scoreLogs.reduce((sum, l) => sum + (l.type !== 'cancelled' ? (parseInt(l.value)||0) : 0), 0);
                t.score = stageSum + logsSum;
                found = false; // reset for next? No, just keep going
            }
        });
        
        await updateCamp(id, { teams });
        await broadcastState(id); res.json({success: true});
    } else {
        res.status(403).json({error: 'locked'});
    }
});

app.listen(PORT, '0.0.0.0', () => console.log(`Server running on port ${PORT}`));
