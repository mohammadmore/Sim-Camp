# Superadmin password (required in production; if unset a random one is generated and printed once)
SUPERADMIN_PASS=change-me-to-a-long-password

# Optional: secret used to sign login sessions (otherwise generated and stored in the database)
SESSION_SECRET=

# Firebase Admin service account JSON (one line). Required for the locked-down firestore.rules.
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to the path of the JSON file.
FIREBASE_SERVICE_ACCOUNT=

# Database adapter: firebase (default) | memory (local testing only, data is lost on restart)
DB_ADAPTER=firebase

PORT=3000

# ---- Resilience (defaults shown; usually no need to change) ----
# DB_TIMEOUT_MS=10000        one database call
# LOCK_WAIT_MS=20000         waiting behind other writes to the same camp
# LOCK_HOLD_MS=15000         one write operation
# RATE_READ_PER_MIN=3000     per IP (a whole venue often shares one IP)
# RATE_WRITE_PER_MIN=1200    per IP
# SSE_MAX_PER_IP=100         open live boards per IP
# SSE_MAX_TOTAL=3000         open live boards in total
# BODY_LIMIT_SMALL=256kb     normal requests
# BODY_LIMIT_LARGE=10mb      setup/settings/profile picture (images), signed-in users only
# TRUST_PROXY=1              hops of reverse proxy in front (Cloud Run, nginx); 0 when exposed directly
# BODY_LIMIT_IMPORT=100mb    restoring a backup file (superadmin only)

# ---- Storage, cache and backups ----
# FIREBASE_STORAGE_BUCKET=   bucket for images (default: storageBucket in firebase-applet-config.json)
# MEDIA_BACKEND=             storage | firestore (default: Storage when available, else Firestore)
# CACHE_IDLE_MINUTES=10      unused camps leave the in-memory cache
# MEDIA_CACHE_MB=64          images kept in memory
# TRASH_DAYS=30              deleted camps can be restored for this many days
# FIRESTORE_DATABASE_ID=     override firestoreDatabaseId of firebase-applet-config.json
